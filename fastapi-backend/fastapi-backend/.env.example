# ============================================================
# FastAPI Backend - Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to `.env` (for local dev) or `.env.production` (for prod)
#   2. Fill in ALL required values before starting the application
#   3. NEVER commit .env or .env.production to Git
#   4. Rotate ALL keys in this file if they were ever committed to Git
# ============================================================

# --- Application ---
ENVIRONMENT=development  # development | production

# --- Supabase (REQUIRED) ---
# Get these from: https://app.supabase.com/project/<your-project-id>/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- JWT (REQUIRED) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:4000,http://localhost:5173

# --- Customer Portal Website Webhook ---
# URL of the spanker website webhook endpoint
# Dev:  http://localhost:3000/api/webhooks/crm
# Prod: https://yourdomain.com/api/webhooks/crm
# Leave empty to disable webhook (CRM still works normally)
PORTAL_WEBHOOK_URL=

# HMAC-SHA256 secret shared with the website (must match CRM_WEBHOOK_SECRET in spanker .env.local)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PORTAL_WEBHOOK_SECRET=

# Webhook request timeout in seconds (default: 5)
PORTAL_WEBHOOK_TIMEOUT=5

# --- Flight Scraping ---
FLIGHT_CACHE_TTL_HOURS=12
USE_REMOTE_BROWSER=true
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# --- Bright Data (optional - for advanced flight scraping) ---
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_ZONE=scraping_browser
BRIGHTDATA_PASSWORD=
