# ============================================================
# Frontend — Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to `.env.local` (development) and fill in values
#   2. Add the same variables to Vercel → Settings → Environment Variables
#   3. NEVER commit .env.local or .env.production to Git
# ============================================================

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key — safe to expose in the browser
VITE_SUPABASE_ANON_KEY=

# ── FastAPI Backend (OPTIONAL) ───────────────────────────────────────────────
# Only needed if you have a self-hosted FastAPI backend for flights/hotels/visa.
# Leave empty if you are using Supabase-only mode.
#
# Example: https://your-backend.railway.app/api/v1
VITE_API_URL=
